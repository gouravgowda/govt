      {
        "field": "sector",
        "operator": "in",
        "value": [
          "manufacturing",
          "services",
          "trading",
          "agriculture",
          "handicraft",
          "tech",
          "other"
        ],
        "required": false,
        "actionable": false,
        "label": "Sector covered"
      },
      {
        "field": "funding_need",
        "operator": "in",
        "value": [
          "under 50k",
          "50k to 5 lakh",
          "5 to 10 lakh",
          "10 to 50 lakh",
          "50 lakh to 1 crore"
        ],
        "required": true,
        "actionable": true,
