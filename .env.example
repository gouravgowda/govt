# Gov Scheme Matcher — local dev
# Copy to .env and fill in only if you want live LLM features.
# Without keys the app runs fully offline with templated explanations + regex extraction.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
DATA_PATH=data/schemes.json
RANK_WEIGHTS_JSON=
SESSION_TTL_SECONDS=3600
STALENESS_DAYS=180
